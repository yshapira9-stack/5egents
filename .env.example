# ===== Reuven's Team — Environment Variables (example) =====
# Copy this file to .env and fill in real values.
# DO NOT commit .env — it contains secrets.

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Image generation (Yuval) ---
# e.g. OpenAI / other image provider key
IMAGE_API_KEY=your-image-api-key-here
# OpenAI key for the gpt-image-gen skill (model: gpt-image-2)
OPENAI_API_KEY=your-openai-api-key-here

# --- Research / web search (Chen) ---
SEARCH_API_KEY=your-search-api-key-here

# --- CRM (Dani + Yehuda) — fixdigital (asset/company IDs, query-string API) ---
# Get assetId/assetTypeId/companyId from the digital asset's "חיבור אתר" tab
# in the fixdigital dashboard (נכסים → <the asset> → חיבור אתר → API URL shown there).
# Dani (jewelry) and Yehuda (studies) each need their own API asset in fixdigital;
# Yehuda's vars use the _YEHUDA suffix. create-lead.mjs picks automatically by
# the lead file's folder (דני/לידים vs יהודה/לידים).
CRM_API_BASE=https://www.fixdigital.co.il/api/v1.2
CRM_LEAD_PATH=/lead/addApi
CRM_ASSET_ID=your-asset-id-here
CRM_ASSET_TYPE_ID=your-asset-type-id-here
CRM_COMPANY_ID=your-company-id-here
CRM_CHANNEL_ID=
CRM_API_KEY=your-crm-api-key-here
CRM_FORM_URL=dani-whatsapp
CRM_URL_REFER=whatsapp
CRM_ASSET_ID_YEHUDA=your-yehuda-asset-id-here
CRM_ASSET_TYPE_ID_YEHUDA=your-yehuda-asset-type-id-here
CRM_COMPANY_ID_YEHUDA=your-yehuda-company-id-here

# --- WhatsApp (Dani) — 360dialog (WhatsApp Business Platform, not Meta directly) ---
# Get D360_API_KEY from 360dialog Hub → your channel → Direct API Access → Generate API key.
WHATSAPP_BUSINESS_NUMBER=+972500000000
YANIV_WHATSAPP=+972500000000
STUDIO_WHATSAPP=+972500000000
D360_API_KEY=your-360dialog-api-key-here
D360_BASE_URL=https://waba-v2.360dialog.io
WHATSAPP_TEST_NUMBER=
WHATSAPP_VERIFY_TOKEN=dani-verify
WHATSAPP_WEBHOOK_PORT=3030

# --- General ---
# development | production
APP_ENV=development
LOG_LEVEL=info
