# ===== Reuven's Team — Environment Variables (example) =====
# Copy this file to .env and fill in real values.
# DO NOT commit .env — it contains secrets.

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Image generation (Yuval) ---
# e.g. OpenAI / other image provider key
IMAGE_API_KEY=your-image-api-key-here

# --- Research / web search (Chen) ---
SEARCH_API_KEY=your-search-api-key-here

# --- General ---
# development | production
APP_ENV=development
LOG_LEVEL=info
