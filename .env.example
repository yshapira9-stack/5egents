# ===== Reuven's Team — Environment Variables (example) =====
# Copy this file to .env and fill in real values.
# DO NOT commit .env — it contains secrets.

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Image generation (Yuval) ---
# e.g. OpenAI / other image provider key
IMAGE_API_KEY=your-image-api-key-here
# OpenAI key for the gpt-image-gen skill (model: gpt-image-2)
OPENAI_API_KEY=your-openai-api-key-here

# --- Research / web search (Chen) ---
SEARCH_API_KEY=your-search-api-key-here

# --- CRM (Dani) — fixdigital (api_key + account IDs, query-string API) ---
# Get the four IDs + api_key from fixdigital (see דני/מכתב-בקשת-API.md).
CRM_API_BASE=https://www.fixdigital.co.il/api/v1.2
CRM_LEAD_PATH=/lead/addApi
CRM_CLIENT_ID=your-crm-clientid-here
CRM_TENANT_ID=your-crm-tenantid-here
CRM_PROJECT_ID=your-crm-projectid-here
CRM_PROJECT_TYPE_ID=your-crm-projecttypeid-here
CRM_CHANNEL_ID=
CRM_API_KEY=your-crm-api-key-here
CRM_FORM_URL=dani-whatsapp
CRM_URL_REFER=whatsapp

# --- General ---
# development | production
APP_ENV=development
LOG_LEVEL=info
